# Variables del backend (clavepui-webhook). Copia a .env (NO se versiona) y
# llena los valores; en Railway se configuran en el servicio. Detalle de cada
# una en CLAUDE.md, sección "Variables de entorno Railway".

# --- Servidor ---
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080

# --- Seguridad (obligatorias) ---
# Secreto para firmar los JWT (staff y PUI gobierno). El servidor no arranca sin él.
JWT_SECRET=
# Opcional. Duración del JWT de la PUI gobierno en segundos (default 3600).
JWT_EXPIRY_SECONDS=3600
# Token del header x-admin-token para /admin/*.
ADMIN_TOKEN=

# --- Base de datos (obligatoria) ---
# Rol dueño de las tablas (pool / withAdminContext). El servidor no arranca sin él.
DATABASE_URL=postgresql://usuario:password@localhost:5432/clavepui
# Rol restringido SIN superusuario/BYPASSRLS (tenantPool / withHotelContext).
# En local puede omitirse (cae a DATABASE_URL); en Railway es obligatorio.
DATABASE_URL_TENANT=

# --- Redis (cola BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Notificaciones push (Feature 18, pausada) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@clavepui.com

# --- Servicio de OCR de INE (repo clavepui-ocr) — opcionales ---
# Sin estas dos, POST /ocr/ine responde 503 "ocr_no_configurado" y el resto de
# la app funciona igual.
# URL del servicio. En local, el contenedor publicado en 8001 (este backend ya
# usa el 8080): docker run -p 127.0.0.1:8001:8080 … → http://127.0.0.1:8001
# En Railway, la de la RED PRIVADA, nunca una pública:
#   http://clavepui-ocr.railway.internal:8080
OCR_SERVICE_URL=
# Secreto compartido con el servicio (header X-OCR-Token). MISMO valor que el
# OCR_SERVICE_TOKEN del servicio; mínimo 32 caracteres (openssl rand -hex 32).
OCR_SERVICE_TOKEN=
# Timeout del reenvío al servicio de OCR, en ms.
OCR_TIMEOUT_MS=10000
